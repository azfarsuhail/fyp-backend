# Offline / local stack (docker-compose.offline.yml)
# Copy to .env.offline (gitignored) and replace every "change-me" value.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-at-least-32-characters-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ── Local PostgreSQL ─────────────────────────────────────────────────────────
# POSTGRES_* configure the postgres container; DATABASE_URL must repeat them.
POSTGRES_USER=kneeoa
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=knee_oa
DATABASE_URL=postgresql://kneeoa:change-me-db-password@postgres:5432/knee_oa

# ── Object storage (MinIO-compatible) ────────────────────────────────────────
# MINIO_ROOT_* configure the storage container; AWS_* must repeat them.
MINIO_ROOT_USER=kneeoa-admin
MINIO_ROOT_PASSWORD=change-me-minio-password
AWS_ACCESS_KEY_ID=kneeoa-admin
AWS_SECRET_ACCESS_KEY=change-me-minio-password
AWS_REGION=us-east-1
S3_BUCKET_NAME=knee-oa-uploads
# API → storage (inside the docker network)
S3_ENDPOINT_URL=http://minio:9000
# Host that browsers / Expo web / the emulator use to open presigned URLs.
# For the Android emulator run: adb reverse tcp:9000 tcp:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000

# ── CORS ─────────────────────────────────────────────────────────────────────
# NGINX on :80, Expo web (8081 = SDK 49+, 19006 = older SDKs)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8081,http://localhost:19006

# ── Email ────────────────────────────────────────────────────────────────────
# Left unset offline: OTP / password-reset emails are skipped.
# RESEND_API_KEY=
